# Option A: MongoDB Atlas (M0 Free / Flex / Dedicated on GCP)
# maxPoolSize=20 & maxIdleTimeMS=60000 suit async FastAPI (AsyncMongoClient) across
# serverless Cloud Run instances while staying well within Atlas M0's 500-connection limit.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&maxPoolSize=20&maxIdleTimeMS=60000&appName=habit-tracker

# Option B: Local MongoDB via Docker Compose (uncomment to use locally without Atlas)
# MONGODB_URI=mongodb://localhost:27017

MONGODB_DB_NAME=habit_tracker
JWT_SECRET=replace-me-with-a-secure-random-32-byte-secret
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=*
